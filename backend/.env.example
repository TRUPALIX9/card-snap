# Copy to backend/.env and fill in. Never commit the real .env.

# MongoDB connection string (Atlas or local), required
MONGO_URI=

# Port the API listens on (defaults to 5091)
PORT=

# "true" logs every request and response body to the console
LOG_RESPONSE=

# Hugging Face Inference API token, optional (NER step is skipped when empty)
HUGGINGFACE_API_KEY=

# "production" disables the /api/playground/system and /db diagnostics
NODE_ENV=
